{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {
    "url": "https://raw.githubusercontent.com/narcisbalint2002/COMP40610/refs/heads/main/HPA02.20251130T191116.csv",
    "format": { "type": "csv" }
  },

  "params": [
    {
      "name": "buyerParam",
      "value": "Household Buyer - All",
      "bind": {
        "input": "select",
        "name": "Buyer Type: ",
        "options": [
          "All Buyer Types",
          "Household Buyer - All",
          "Household Buyer - First-Time Buyer Owner-Occupier",
          "Household Buyer - Former Owner-Occupier",
          "Household Buyer - Non-Occupier",
          "Non-Household Buyer"
        ]
      }
    },
    {
      "name": "yearParam",
      "value": 2015,
      "bind": {
        "input": "range",
        "name": "Year: ",
        "min": 2010,
        "max": 2024,
        "step": 1
      }
    }
  ],

  "vconcat": [

    {
      "title": {
        "text": "Trend in Property Sales Volume Over Time",
        "fontSize": 18,
        "fontWeight": "bold",
        "anchor": "start"
      },
      "transform": [
        { "filter": "datum['Statistic Label'] == 'Volume of Sales'" },
        { "filter": "datum['Dwelling Status'] == 'All Dwelling Statuses'" },
        { "filter": "datum['Stamp Duty Event'] == 'Filings'" },
        { "filter": "datum['Type of Sale'] == 'All Sale Types'" },
        { "filter": "datum['Type of Buyer'] == buyerParam" },
        { "filter": "datum.County != 'All Counties'" },
        { "filter": { "param": "countySelection" } },
        {
          "aggregate": [
            { "op": "sum", "field": "VALUE", "as": "TotalSales" }
          ],
          "groupby": ["Year"]
        }
      ],
      "width": 650,
      "height": 220,
      "mark": {
        "type": "line",
        "point": true
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "sort": "ascending"
        },
        "y": {
          "field": "TotalSales",
          "type": "quantitative",
          "title": "Sales volume (selected counties)"
        },
        "color": { "value": "#2563eb" },
        "tooltip": [
          { "field": "Year", "title": "Year" },
          { "field": "TotalSales", "type": "quantitative", "title": "Sales volume" }
        ]
      }
    },

    {
      "title": {
        "text": "Property Sales Volume by County (Selected Year)",
        "fontSize": 18,
        "fontWeight": "bold",
        "anchor": "start"
      },
      "params": [
        {
          "name": "countySelection",
          "select": {
            "type": "point",
            "fields": ["County"],
            "toggle": "event.shiftKey",
            "empty": true
          }
        }
      ],
      "transform": [
        { "filter": "datum['Statistic Label'] == 'Volume of Sales'" },
        { "filter": "datum['Dwelling Status'] == 'All Dwelling Statuses'" },
        { "filter": "datum['Stamp Duty Event'] == 'Filings'" },
        { "filter": "datum['Type of Sale'] == 'All Sale Types'" },
        { "filter": "datum['Type of Buyer'] == buyerParam" },
        { "filter": "datum.Year == yearParam" },
        { "filter": "datum.County != 'All Counties'" }
      ],
      "width": 650,
      "height": 260,
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "County",
          "type": "nominal",
          "sort": "-x",
          "title": "County"
        },
        "x": {
          "field": "VALUE",
          "type": "quantitative",
          "title": "Sales volume"
        },
        "color": { "value": "#4a8be3" },
        "opacity": {
          "condition": { "param": "countySelection", "value": 1 },
          "value": 0.3
        },
        "tooltip": [
          { "field": "County", "title": "County" },
          { "field": "Year", "title": "Year" },
          { "field": "Type of Buyer", "title": "Buyer type" },
          { "field": "VALUE", "type": "quantitative", "title": "Sales volume" }
        ]
      }
    },

    {
      "title": {
        "text": "Sales Volume by County and Year",
        "fontSize": 18,
        "fontWeight": "bold",
        "anchor": "start"
      },
      "transform": [
        { "filter": "datum['Statistic Label'] == 'Volume of Sales'" },
        { "filter": "datum['Dwelling Status'] == 'All Dwelling Statuses'" },
        { "filter": "datum['Stamp Duty Event'] == 'Filings'" },
        { "filter": "datum['Type of Sale'] == 'All Sale Types'" },
        { "filter": "datum['Type of Buyer'] == buyerParam" },
        { "filter": "datum.County != 'All Counties'" },
        { "filter": { "param": "countySelection" } }
      ],
      "width": 650,
      "height": 400,
      "mark": "rect",
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "sort": "ascending"
        },
        "y": {
          "field": "County",
          "type": "nominal",
          "title": "County"
        },
        "color": {
          "field": "VALUE",
          "type": "quantitative",
          "title": "Sales volume",
          "scale": {
            "range": ["#e8f1fa", "#8ab6e6", "#1749b4"]
          }
        },
        "tooltip": [
          { "field": "County", "title": "County" },
          { "field": "Year", "title": "Year" },
          { "field": "Type of Buyer", "title": "Buyer type" },
          { "field": "VALUE", "type": "quantitative", "title": "Sales volume" }
        ]
      }
    }
  ],

  "config": {
    "background": "white",
    "padding": 10,

    "view": { "stroke": null },

    "axis": {
      "labelFont": "Sans-Serif",
      "titleFont": "Sans-Serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#333",
      "titleColor": "#333",
      "tickColor": "#ccc",
      "domainColor": "#ccc",
      "grid": true,
      "gridColor": "#eee",
      "gridDash": [2, 2],
      "labelLimit": 120
    },

    "legend": {
      "labelFont": "Sans-Serif",
      "titleFont": "Sans-Serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "right",
      "symbolType": "square",
      "offset": 10
    },

    "mark": {
      "tooltip": true
    }
  }
}
